# ============================================================================
# Krishna Universe - example environment variables
# Copy this file to ".env" and fill in your own values. NEVER commit your .env.
# In GitHub Actions, set these as repository Secrets instead (Settings ->
# Secrets and variables -> Actions).
# ============================================================================

# --- Google Gemini (AI script generation) -------------------------------
# Get a free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the default model (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# --- Pexels (free stock video + photos) ----------------------------------
# Get a free key: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# --- Text-to-speech (optional override) ----------------------------------
# Defaults to a warm USA female voice. edge-tts is tried first, gTTS as fallback.
TTS_VOICE=en-US-AriaNeural

# --- YouTube upload (OAuth2) ----------------------------------------------
# Paste the FULL JSON CONTENTS (one line is fine) of each file below.
# YT_CLIENT_SECRET_JSON = the OAuth client secret downloaded from Google Cloud
#   Console (the whole {"installed":{...}} or {"web":{...}} object).
# YT_TOKEN_JSON = an authorized token JSON (refresh token). Produce it once via
#   `python upload_youtube.py --authorize` or the Google OAuth Playground.
YT_CLIENT_SECRET_JSON={"installed":{"client_id":"...","client_secret":"...","redirect_uris":["http://localhost"]}}
YT_TOKEN_JSON={"token":"...","refresh_token":"...","client_id":"...","client_secret":"...","scopes":["https://www.googleapis.com/auth/youtube.upload"]}

# --- Instagram (OPTIONAL, OFF by default, ban risk) -----------------------
# Only used if config.instagram.enabled is set to true.
IG_USERNAME=your_instagram_username
IG_PASSWORD=your_instagram_password
